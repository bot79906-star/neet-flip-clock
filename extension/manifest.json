{
  "manifest_version": 3,
  "name": "NEET 2028 Flip Clock",
  "version": "4.4.0",
  "description": "A luxury flip-clock new tab for NEET 2028: Pomodoro focus timer, calibrated plan ruler, reference dates, motivation lines, and sync between Chrome and Edge.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "notifications",
    "system.display"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show the NEET reminder now"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "version_name": "4.4 Sync",
  "minimum_chrome_version": "116"
}
